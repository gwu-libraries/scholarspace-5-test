# Production/ECS Environment Template
# Core App Identity
# APP_NAME is injected by Terraform from site_prefix.

SECRET_KEY_BASE=
# If both ALLOWED_HOSTS_REGEX and HOST_NAME are populated, both are allowed.
# Restart nginx after changing HOST_NAME and/or ALLOWED_HOSTS_REGEX.
ALLOWED_HOSTS_REGEX=
HOST_NAME=

# Runtime and Concurrency
RAILS_LOG_TO_STDOUT=true
WEB_CONCURRENCY=2
RAILS_MAX_THREADS=5

# App Behavior and Integrations
CH12N_TOOL=fits_servlet
HYRAX_UPLOAD_PATH=/app/scholarspace/uploads/
VALKYRIE_METADATA_ADAPTER=fedora_metadata
VALKYRIE_STORAGE_ADAPTER=fedora_storage

# Database Configuration
DB_PASSWORD=hyrax_password

# Fedora credentials and timeouts
FEDORA_USER=fedoraAdmin
FEDORA_PASSWORD=fedoraAdmin
FEDORA_OPEN_TIMEOUT_SECONDS=60
FEDORA_TIMEOUT_SECONDS=14400
FEDORA_READ_TIMEOUT_SECONDS=14400
FEDORA_WRITE_TIMEOUT_SECONDS=14400

# Google Analytics / OAuth (optional)
GOOGLE_ANALYTICS_ID=
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_ACCOUNT_JSON=
GOOGLE_ACCOUNT_JSON_PATH=
GOOGLE_OAUTH_APP_NAME=
GOOGLE_OAUTH_APP_VERSION=
GOOGLE_OAUTH_PRIVATE_KEY_PATH=
GOOGLE_OAUTH_PRIVATE_KEY_VALUE=
GOOGLE_OAUTH_CLIENT_EMAIL=