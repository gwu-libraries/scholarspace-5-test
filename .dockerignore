# Prevent host platform artifacts from being baked into images.
node_modules
public/packs

# Keep local runtime/build outputs out of Docker context.
log
tmp
coverage
uploads
storage
derivatives

# Keep git metadata and editor settings out of build context.
.git
.gitignore
.vscode

vendor/bundle
.bundle

# Build/deploy metadata not needed inside the app image.
terraform
*.tfstate
*.tfstate.backup
*.plan

# Test/docs content not needed for runtime image.
spec
README.md