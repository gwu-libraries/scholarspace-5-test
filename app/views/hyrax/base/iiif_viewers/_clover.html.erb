<%
  @page_js_packs = Array(@page_js_packs) | ["clover-bundler"]
  @page_css_packs = Array(@page_css_packs) | ["clover-bundler"]
%>

<%
  presenter = local_assigns[:presenter] || @presenter
  clover_props = {
    manifestUrl: main_app.polymorphic_url([main_app, :manifest, presenter], { locale: nil })
  }
%>

<%= react_component(
  "Clover",
  props: clover_props,
) %>
