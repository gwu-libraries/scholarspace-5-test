# Custom FITS servlet image with ARM64 MediaInfo library support
FROM ghcr.io/samvera/fitsservlet:1.6.0

# Install MediaInfo which provides the ARM64 native libraries
RUN apt-get update -qq && \
    apt-get install -y -qq mediainfo && \
    rm -rf /var/lib/apt/lists/*

# Copy ARM64 MediaInfo libraries to FITS tools directory
# This enables FITS to use MediaInfo on ARM64 (including Apple Silicon)
RUN cp /usr/lib/aarch64-linux-gnu/libmediainfo.so.0 /opt/fits/tools/mediainfo/linux/libmediainfo.so.0 && \
    cp /usr/lib/aarch64-linux-gnu/libzen.so.0 /opt/fits/tools/mediainfo/linux/libzen.so.0 && \
    echo "ARM64 MediaInfo libraries installed for FITS"
