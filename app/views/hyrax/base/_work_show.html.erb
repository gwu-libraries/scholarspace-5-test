<% work_show_props = @presenter.work_show_props(self) %>

<% content_for(:head) do %>
  <%= stylesheet_pack_tag "work-show-bundler" %>
  <%= javascript_pack_tag "work-show-bundler" %>
<% end %>

<%= react_component(
  "WorkShow",
  props: work_show_props,
  prerender: false,
  html_options: { data: { turbo_cache: false } }
) %>

<div>
  <% @presenter.member_of_collection_ids.each do |collection_id| %>
    <span class='hide analytics-event' data-category="work-in-collection" data-action="work-in-collection-view" data-name="<%= collection_id %>" ></span>
  <% end %>
</div>