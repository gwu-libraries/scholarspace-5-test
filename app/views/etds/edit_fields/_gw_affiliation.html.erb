<%= f.input key,
            as: :multi_value_select,
            collection: Qa::Authorities::Local.subauthority_for('gw_affiliations').all
              .select { |term| term[:active] }
              .map { |term| [term[:label], term[:id]] },
            input_html: { class: 'form-control' },
            required: f.object.required?(key) %>
