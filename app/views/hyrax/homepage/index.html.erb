<%
  provide :page_title, application_name
  add_page_js_pack('homepage-bundler')
%>

<% content_for(:head) do %>
  <%= render_page_pack_tags %>
<% end %>

<div class="row home-content">
  <%= react_component(
    'Homepage',
    props: @homepage_props,
    prerender: false,
    html_options: { data: { turbo_cache: false } }
  ) %>
</div>
