<%
  work_show_props = @presenter.work_show_props(self)
  viewer = work_show_props[:viewer] || {}
  pdf_only_work = viewer[:type] == "pdf_or_images" && !viewer[:hasImages]

  js_pack_name = pdf_only_work ? "work-show-pdf-bundler" : "work-show-bundler"
  component_name = pdf_only_work ? "WorkShowPdfOnly" : "WorkShow"

  add_page_js_pack(js_pack_name)
%>

<%= render_page_pack_tags %>

<%= react_component(
  component_name,
  props: work_show_props,
  prerender: false,
  html_options: { data: { turbo_cache: false } }
) %>

<div>
  <% @presenter.member_of_collection_ids.each do |collection_id| %>
    <span class='hide analytics-event' data-category="work-in-collection" data-action="work-in-collection-view" data-name="<%= collection_id %>" ></span>
  <% end %>
</div>
